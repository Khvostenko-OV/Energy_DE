# Streamlit + PyDeck viz service image (issue #28).
#
# Ships the local viz app (`streamlit run viz/app.py`, viz/ + requirements-viz)
# unchanged in its own container next to the pipeline.  The same packaging
# pattern as the pipeline image: nothing data- or connection-setting-like is
# baked in — the detached data volume mounted at /app/data carries
# /app/data/docker.env, whose VIZ_DATABASE_URL the shared entrypoint sources
# (the app already reads VIZ_DATABASE_URL with a DATABASE_URL fallback in
# viz/data.py).  Requires the provisioning SQL (docker/viz_reader.sql) to have
# run on the database — a fresh compose db does that automatically via its
# /docker-entrypoint-initdb.d hook.

FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Pipeline + viz requirements: the viz runtime layers on top of the pipeline
# set exactly like the documented host install (requirements.txt +
# requirements-viz.txt), so one copy of each stays the single source of truth.
COPY requirements.txt requirements-viz.txt ./
RUN pip install -r requirements.txt -r requirements-viz.txt

# The viz package and the etl package it imports (<etl.db_schema> supplies
# CORE_SCHEMA; the etl requirements are already installed above).
COPY viz/ ./viz/
COPY etl/ ./etl/

COPY docker/entrypoint.sh /usr/local/bin/etl-entrypoint
RUN chmod +x /usr/local/bin/etl-entrypoint

# Reachable inside the container and from the compose network; the host port
# mapping (VIZ_PORT, 8501) lives in compose.yaml.  headless: no "email to
# upgrade" prompt to block startup in the container.
STOPSIGNAL SIGINT

ENTRYPOINT ["etl-entrypoint"]
CMD ["streamlit", "run", "viz/app.py", \
     "--server.headless", "true", \
     "--server.address", "0.0.0.0", \
     "--server.port", "8501"]