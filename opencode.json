{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "wc *": "allow",
      "cat *": "allow",
      "echo *": "allow",
      "find *": "allow",
      "pip *": "allow",
      "psql *": "allow",
      "tail *": "allow",
      "source *": "allow",
      "python *": "allow",
      ".venv/bin/python *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git branch *": "allow",
      "git push *": "ask",
      "gh issue *": "allow",
      "gh repo view *": "allow",
      "gh label *": "allow",
      "npm *": "ask",
      "rm *": "deny",
      "sudo *": "deny",
      "curl *": "deny"
    },
    "edit": {
      "*": "allow"
    },
    "webfetch": "ask"
  }
}