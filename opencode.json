{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "bash": {
      "*": "ask",
      "ls*": "allow",
      "wc *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "for *": "allow",
      "cat *": "allow",
      "echo *": "allow",
      "find *": "allow",
      "mkdir *": "allow",
      "pip *": "allow",
      "psql *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "source *": "allow",
      "python *": "allow",
      ".venv/bin/python *": "allow",
      "git *": "allow",
      "git push*": "ask",
      "git pull*": "ask",
      "git fetch*": "ask",
      "git rebase*": "deny",
      "git reset*": "ask",
      "git init*": "ask",
      "gh *": "allow",
      "gh org*": "ask",
      "gh repo*": "ask",
      "gh repo view*": "allow",
      "gh api*": "ask",
      "gh secret*": "ask",
      "gh ssh*": "deny",
      "gh config*": "deny",
      "gh copilot*": "deny",
      "npm *": "ask",
      "rm *": "deny",
      "sudo *": "deny",
      "curl *": "deny"
    },
    "edit": {
      "*": "allow"
    },
    "webfetch": "ask"
  }
}